# URL base del backend (Spring Boot), sin "/api" al final.
VITE_API_BASE_URL=http://localhost:8080

# true  -> usa datos simulados (mocks) sin necesitar el backend levantado
# false -> llama al backend real definido en VITE_API_BASE_URL
VITE_USE_MOCKS=false

# Opcionales: deben coincidir con las reglas del back
# VITE_MIN_NOTICE_HOURS=24
# VITE_MAX_NOTICE_DAYS=30
